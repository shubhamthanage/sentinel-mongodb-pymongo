# Copy this file to .env and fill in your own values. Never commit .env.

# Atlas connection string (Connect -> Drivers). URL-encode special characters in the password, e.g. @ -> %40
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database name (optional, default: sentinel)
MONGODB_DB=sentinel

# Path to the SENTINEL kit's data/tables folder (the *.csv.gz files)
DATA_DIR=supabase_db_kit/data/tables

# How many transactions to load (optional, default 20000; minimum for the task is 5000; 0 = load everything)
TARGET_TXNS=20000
